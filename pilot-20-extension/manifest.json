{
  "manifest_version": 3,
  "name": "Pumpkin Latte Enrichment Pilot",
  "version": "0.2.3",
  "description": "Fifty-post enrichment pilot with automatic unavailable-post skip, stall watchdog, and safer permalink fallback",
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://ltznpjfnkpydautbsrej.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*"
      ],
      "js": [
        "core.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
