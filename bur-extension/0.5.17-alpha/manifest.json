{
  "manifest_version": 3,
  "name": "FB Бур — универсальный коллектор (alpha)",
  "short_name": "FB Бур",
  "version": "0.5.16",
  "version_name": "0.5.16-alpha",
  "description": "Пакетный FB-коллектор с явной и сохранённой точкой продолжения по post_id.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "alarms",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://web.facebook.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/groups/*",
        "https://web.facebook.com/groups/*"
      ],
      "js": [
        "core.js",
        "feed-scroll.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Бур: управление сбором",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
