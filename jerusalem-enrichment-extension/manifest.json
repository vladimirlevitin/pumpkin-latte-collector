{
  "manifest_version": 3,
  "name": "Иерусалим по-русски — досбор комментариев",
  "version": "0.1.0",
  "description": "Локальное обогащение ранее найденных постов, без Supabase и без доступа к другим группам.",
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://www.facebook.com/groups/374040476267868/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/groups/374040476267868/*"
      ],
      "js": [
        "core.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
